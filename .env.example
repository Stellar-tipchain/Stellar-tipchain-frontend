# Copy to .env.local and adjust. Every NEXT_PUBLIC_* value is inlined into the
# browser bundle at build time, so none of them may hold a secret.

# Base URL of the backend API that stores creators and tip records.
# Start the backend server before running the app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Which Stellar network to use: testnet or mainnet.
# Anything else falls back to testnet. This picks the Horizon endpoint, the
# network passphrase used for signing, and the block explorer links.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Absolute URL this app is served from. Used for sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
